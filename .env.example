# Stegabyte — environment variables
#
# This application is fully client-side and has no required secrets.
# These keys are reserved for future server-side optional features.
# Copy this file to `.env.local` to set values during local development;
# Vercel project settings provide the production equivalents.

# Site origin used for absolute URLs in Open Graph / metadata.
# In production Vercel sets this from the deployed domain.
# NEXT_PUBLIC_SITE_URL=https://stegabyte.app

# Reserved for future opt-in analytics. Off by default.
# NEXT_PUBLIC_VERCEL_ANALYTICS=false
